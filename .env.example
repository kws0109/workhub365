# ── 앱 등록 #1: 사용자 SSO (delegated) ──────────────────────
AUTH_MICROSOFT_ENTRA_ID_ID=            # 앱(클라이언트) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=        # 클라이언트 시크릿 값
AUTH_MICROSOFT_ENTRA_ID_ISSUER=        # https://login.microsoftonline.com/<테넌트ID>/v2.0
AUTH_SECRET=                           # `npx auth secret`으로 생성
AUTH_URL=http://localhost:3000         # 배포 시 프로덕션 URL

# ── 앱 등록 #2: 관리 액션 (application, app-only) ───────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── DB (Neon Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── AI 어시스턴트 ───────────────────────────────────────────
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5

# ── 부트스트랩 ──────────────────────────────────────────────
ADMIN_EMAILS=                          # 쉼표 구분. 이 이메일들은 로그인 시 admin 역할
